# API — required outside Development
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=logiforge;Username=logiforge;Password=REPLACE_ME
ConnectionStrings__Redis=localhost:6379
Jwt__Key=REPLACE_WITH_32+_CHAR_RANDOM_SECRET
Jwt__Issuer=LogiForge
Jwt__Audience=LogiForge
Cors__Origins__0=https://app.your-domain.com
Swagger__Enabled=false
AzureAd__ClientId=
AzureAd__ClientSecret=
AzureOpenAI__Endpoint=
AzureOpenAI__ApiKey=

# Web
NODE_ENV=production
API_ORIGIN=http://api:8080
NEXT_PUBLIC_API_URL=/api/v1
# Set true ONLY for sandboxed demos. Leave unset/false for production publishes.
NEXT_PUBLIC_ALLOW_DEMO_LOGIN=false
