# API — required outside Development
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=logiforge;Username=logiforge;Password=REPLACE_ME
ConnectionStrings__Redis=localhost:6379
Jwt__Key=REPLACE_WITH_32+_CHAR_RANDOM_SECRET
Jwt__Issuer=LogiForge
Jwt__Audience=LogiForge
Cors__Origins__0=https://app.your-domain.com
Swagger__Enabled=false
AzureAd__ClientId=
AzureAd__ClientSecret=
AzureOpenAI__Endpoint=
AzureOpenAI__ApiKey=

# Web
NODE_ENV=production
API_ORIGIN=http://api:8080
NEXT_PUBLIC_API_URL=/api/v1
# Public site URL used for canonical tags, sitemap, Open Graph
NEXT_PUBLIC_SITE_URL=https://logiforge.com
# Set true ONLY for sandboxed demos. Leave unset/false for production publishes.
NEXT_PUBLIC_ALLOW_DEMO_LOGIN=false
# Require the marketing access form before /login (default: required).
NEXT_PUBLIC_REQUIRE_ACCESS_REQUEST=true
# Demo request emails (delivered to DEMO_REQUEST_TO)
DEMO_REQUEST_TO=tirthsoni1810@gmail.com
# Preferred: Resend
RESEND_API_KEY=
DEMO_REQUEST_FROM=LogiForge <onboarding@resend.dev>
# Or Gmail SMTP (use an App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tirthsoni1810@gmail.com
SMTP_PASS=
